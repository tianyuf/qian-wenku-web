[Unit]
Description=Qian Wenku MCP server (hosted, HTTP)
After=network-online.target qian-wenku-web.service
Wants=network-online.target

[Service]
Type=simple
User=qian-wenku-web
Group=qian-wenku-web
WorkingDirectory=/opt/qian-wenku-web
EnvironmentFile=/opt/qian-wenku-web/.env
# WENKU_MCP_TOKEN comes from the env file — required.
# WENKU_BASE_URL can be overridden there too; defaults to https://wenku.qianxuesen.org.
ExecStart=/opt/qian-wenku-web/.venv/bin/python -m qian_wenku_mcp.server --http --host=127.0.0.1 --port=8100
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/opt/qian-wenku-web
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
